{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "service",
    "severity",
    "customer_impact"
  ],
  "properties": {
    "incident_id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "severity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        "critical",
        null
      ]
    },
    "customer_impact": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
